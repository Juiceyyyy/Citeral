# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI - zero-cost, privacy-preserving reference configuration.
# Workers AI Free: requests fail at the daily free limit instead of auto-billing.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
DAILY_MESSAGE_LIMIT=200
MAX_RAG_CHUNKS=10

# Paid providers are disabled unless explicitly opted into.
ALLOW_BILLABLE_AI=false
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
OPENAI_MODEL=

# Server/worker only. SUPABASE_SERVICE_ROLE_KEY is also used by the production web server for irreversible account deletion cleanup. Never expose privileged Supabase credentials to browser code or NEXT_PUBLIC_* variables.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_POLL_SECONDS=3
WORKER_BATCH_SIZE=4
WORKER_ONESHOT=true
MAX_SOURCE_BYTES=52428800

# Malware scanning. GitHub Actions runs an official ClamAV service container.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=true
